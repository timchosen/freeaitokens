// sync.freeaitokens.co: the encrypted sync server. Setup steps are in sync/README.md.
{
  "name": "freeaitokens-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "routes": [{ "pattern": "sync.freeaitokens.co", "custom_domain": true }],
  // database_id comes from `wrangler d1 create freeaitokens-sync` (owner step).
  "d1_databases": [{ "binding": "SYNC_DB", "database_name": "freeaitokens-sync", "database_id": "89065b5c-32aa-4135-8218-8fcd26baee13" }],
  "r2_buckets": [{ "binding": "SYNC_BLOBS", "bucket_name": "freeaitokens-sync" }],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["17 3 * * *"] },
  // Stripe LIVE price ids (test mode: year price_1UfGrQDeqZ4b9PUcS5Yv93rs, lifetime price_1UfGrRDeqZ4b9PUcp75JgLv3). Deploy only with the live secrets in place.
  "vars": { "SITE_URL": "https://freeaitokens.co", "STRIPE_PRICE_YEAR": "price_1UfJUJDeqZ4b9PUc2TADyeho", "STRIPE_PRICE_LIFE": "price_1UfJUKDeqZ4b9PUcBhYxU2rD" }
  // Secrets (wrangler secret put): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, LICENSE_SECRET, EMAIL_SECRET
}
