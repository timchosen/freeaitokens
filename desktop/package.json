{
  "name": "freeaitokens-desktop",
  "productName": "freeaitokens",
  "version": "0.4.10",
  "private": true,
  "description": "freeaitokens in your menu bar: free AI from many providers on one local endpoint.",
  "type": "module",
  "main": "main.js",
  "license": "MIT",
  "author": "Timchosen Uzua",
  "homepage": "https://github.com/timchosen/freeaitokens",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "freeaitokens": "file:..",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.timchosen.freeaitokens",
    "files": [
      "main.js",
      "logic.js",
      "chats.js",
      "docs.js",
      "search.js",
      "syncsvc.js",
      "preload.cjs",
      "add.html",
      "app.html",
      "app.js",
      "md.js",
      "brands.js",
      "app.css",
      "preload-app.cjs",
      "t.js",
      "i18n/*.json",
      "icons/**",
      "logos/**"
    ],
    "icon": "icons/icon.png",
    "mac": {
      "x64ArchFiles": "**/keyring.darwin-*.node",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "FreeAITokens-mac.${ext}",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "FreeAITokens uses the microphone only while you record with the mic button, to turn what you say into text."
      },
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "FreeAITokens-windows.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Timchosen Uzua"
    },
    "appImage": {
      "artifactName": "FreeAITokens-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "FreeAITokens-linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "timchosen",
      "repo": "freeaitokens"
    }
  }
}
