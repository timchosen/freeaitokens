    "type": "git",
    "url": "git+https://github.com/timchosen/freeaitokens.git"
  },
  "homepage": "https://github.com/timchosen/freeaitokens#readme",
  "bugs": {
    "url": "https://github.com/timchosen/freeaitokens/issues"
  },
  "keywords": [
    "free",
    "llm",
    "ai",
    "free-tier",
    "openai-compatible",
    "anthropic",
    "gemini",
    "ollama",
    "router",
    "claude-code",
    "codex",
    "gemini-cli",
