{
  "name": "freeaitokens",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "freeaitokens": "dist/node/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "tsc && cp src/catalogue.json dist/catalogue.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@napi-rs/keyring": "^2.1.2"
  },
  "license": "MIT",
