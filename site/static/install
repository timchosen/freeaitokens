#!/bin/sh
# Installs the FreeAITokens desktop app from its latest GitHub release. Nothing else is changed.
#   macOS: the app goes into /Applications (or ~/Applications if that is not writable) and opens.
#   Linux: the AppImage goes to ~/.local/share/freeaitokens, started by the command ~/.local/bin/freeaitokens-app.
# Source and explanation: https://{{domain}}/install-script
set -eu

# Everything is in main, so a download cut off halfway runs nothing.
main() {
BASE="{{repoUrl}}/releases/latest/download"
OS="${FREEAITOKENS_OS:-$(uname -s)}"
ARCH="${FREEAITOKENS_ARCH:-$(uname -m)}"
DRY="${FREEAITOKENS_DRY_RUN:-}"

fail() { echo "FreeAITokens: $1" >&2; exit 1; }

case "$OS" in
  Darwin)
    FILE="FreeAITokens-mac.zip"
    if [ -w /Applications ]; then DEST="/Applications"; else DEST="$HOME/Applications"; fi
    ;;
  Linux)
    case "$ARCH" in
      x86_64|amd64) FILE="FreeAITokens-linux-x86_64.AppImage" ;;
      aarch64|arm64) FILE="FreeAITokens-linux-arm64.AppImage" ;;
      *) fail "this computer's processor ($ARCH) is not supported. See https://{{domain}}/download" ;;
    esac
    DEST="$HOME/.local/bin/freeaitokens-app"
    ;;
  *) fail "$OS is not supported by this script. On Windows, use the PowerShell line at https://{{domain}}/download" ;;
esac

URL="$BASE/$FILE"
echo "Downloading $URL"
echo "Installing to $DEST"
[ -n "$DRY" ] && exit 0

command -v curl >/dev/null 2>&1 || fail "curl is needed but not installed."
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
curl -fL --progress-bar "$URL" -o "$TMP/$FILE" || fail "the download failed. Check your connection and try again."

if [ "$OS" = Darwin ]; then
  ditto -x -k "$TMP/$FILE" "$TMP/app"
  APP="$(find "$TMP/app" -maxdepth 1 -name '*.app' | head -n 1)"
  [ -n "$APP" ] || fail "the download did not contain the app."
  # An older copy may be running; quit it so the new one starts.
  osascript -e 'quit app id "{{appId}}"' >/dev/null 2>&1 || true
  mkdir -p "$DEST"
  rm -rf "$DEST/$(basename "$APP")"
  mv "$APP" "$DEST/"
  # Not signed by Apple yet: clear the "downloaded from the internet" flag so macOS opens it.
  xattr -dr com.apple.quarantine "$DEST/$(basename "$APP")" 2>/dev/null || true
  echo "Installed $DEST/$(basename "$APP"). Opening it now; look for it in your menu bar."
  open "$DEST/$(basename "$APP")"
else
  # The command is a small launcher: without FUSE (containers, many VMs) the AppImage unpacks itself and runs.
  APPIMAGE="$HOME/.local/share/freeaitokens/FreeAITokens.AppImage"
  mkdir -p "$(dirname "$DEST")" "$(dirname "$APPIMAGE")"
  chmod +x "$TMP/$FILE"
  mv -f "$TMP/$FILE" "$APPIMAGE"
  rm -f "$DEST"
  printf '#!/bin/sh\ncommand -v fusermount >/dev/null 2>&1 && exec "%s" "$@"\n# No FUSE: unpack and run, without listing every unpacked file.\nAPPIMAGE_EXTRACT_AND_RUN=1 "%s" "$@" | grep -v /appimage_extracted_\n' "$APPIMAGE" "$APPIMAGE" > "$DEST"
  chmod +x "$DEST"
  echo "Installed. Start it with: $DEST"
  if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    echo "This computer has no screen, and the app needs one. On a server, use the command-line version instead (Node.js 20 or newer): npx freeaitokens"
  fi
fi
}

main "$@"
