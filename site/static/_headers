/*
  Content-Security-Policy: default-src 'self'; connect-src https://api.github.com https://sync.{{domain}}; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'none'; form-action https://sync.{{domain}}; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/install
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/setup.md
  Content-Type: text/markdown; charset=utf-8
